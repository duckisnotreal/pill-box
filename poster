<div class="zoom" role="group" aria-label="Thu phóng">
<button id="zin" aria-label="Phóng to">+</button>
<button id="zout" aria-label="Thu nhỏ">&minus;</button>
<button id="zfit" aria-label="Vừa màn hình" style="font-size:15px">Vừa</button>
<output id="zv">100%</output>
</div>
<script>
{
const wrap=document.getElementById('wrap'),out=document.getElementById('zv');
const fit=()=>Math.min(1,(document.documentElement.clientWidth-32)/1200);
let z=fit();
const set=v=>{z=Math.max(.3,Math.min(3,v));wrap.style.zoom=z;out.textContent=Math.round(z*100)+'%'};
document.getElementById('zin').onclick=()=>set(z*1.25);
document.getElementById('zout').onclick=()=>set(z/1.25);
document.getElementById('zfit').onclick=()=>set(fit());
addEventListener('keydown',e=>{if(e.ctrlKey||e.metaKey)return;if(e.key==='+'||e.key==='=')set(z*1.25);if(e.key==='-')set(z/1.25);if(e.key==='0')set(fit())});
set(z);
}
</script>
